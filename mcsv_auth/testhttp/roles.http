}

### Create RECEPCIONISTA role
POST {{baseUrl}}/roles
Content-Type: application/json

{
  "description": "RECEPCIONISTA"
}

### Update role
PUT {{baseUrl}}/roles/{{roleId}}
Content-Type: application/json

{
  "description": "Recruiter"
}

### Get role by id
GET {{baseUrl}}/roles/{{roleId}}

### Delete role
DELETE {{baseUrl}}/roles/{{roleId}}

### Get all roles
GET {{baseUrl}}/roles
